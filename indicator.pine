//@version=6
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
//  ARPAN'S TRADING SESSIONS PRO
//  Sessions · Liquidity state machine · Session bias engine · Macro levels · Dashboard
//
//  Phase / bias / flow / ADL / divergence are rule-based readings of price and volume.
//  They are heuristics, not proof of institutional activity and not a prediction.
//
//  Revision notes
//   · Dashboard is live on every tick. It no longer waits for a bar to close, and a new session
//     (Europe, USA, Asia) shows on the dashboard from its very first bar.
//   · Macro levels (PDH/PDL, PWH/PWL, PMH/PML, DO/WO/MO, NY 00:00) can be drawn as a strip in the
//     empty space to the right of the last candle, with a gap, so they never sit on top of candles.
//   · A session that is still building its range is shown as FORMING instead of DEAD.
//   · Flow oscillator guarded against zero volume; PDH/PDL/PWH/PWL alerts no longer fire when the level rolls over.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
indicator("Arpan's Trading Sessions", shorttitle = "Trading Sessions", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1 · INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
G_BOX = "Session Boxes"
G_LIN = "Session Lines & Liquidity"
G_MAC = "Macro Liquidity"
G_BIA = "Bias / Intelligence"
G_DSH = "Dashboard"
G_KZ  = "Killzones & Overlap (NY time)"
G_UI  = "UI & Aesthetics"
G_ALR = "Alerts"
G_ADV = "Advanced / Engine"

// ── Session Boxes (session times are in each exchange's own timezone, DST handled automatically)
show_syd = input.bool(true, "Sydney", inline = "syd", group = G_BOX)
col_syd  = input.color(#00c853, "", inline = "syd", group = G_BOX)
ses_syd  = input.session("1000-1600", "", inline = "syd", group = G_BOX)
show_tok = input.bool(true, "Tokyo", inline = "tok", group = G_BOX)
col_tok  = input.color(#e91e63, "", inline = "tok", group = G_BOX)
ses_tok  = input.session("0900-1500", "", inline = "tok", group = G_BOX)
show_sha = input.bool(true, "Shanghai", inline = "sha", group = G_BOX)
col_sha  = input.color(#9c27b0, "", inline = "sha", group = G_BOX)
ses_sha  = input.session("0930-1500", "", inline = "sha", group = G_BOX)
show_eur = input.bool(true, "London", inline = "eur", group = G_BOX)
col_eur  = input.color(#2157f3, "", inline = "eur", group = G_BOX)
ses_eur  = input.session("0800-1630", "", inline = "eur", group = G_BOX)
show_usa = input.bool(true, "New York", inline = "usa", group = G_BOX)
col_usa  = input.color(#ff5d00, "", inline = "usa", group = G_BOX)
ses_usa  = input.session("0930-1600", "", inline = "usa", group = G_BOX)
merge_asia = input.bool(false, "Merge Asian box (Sydney + Tokyo + Shanghai)", group = G_BOX)
skip_wknd  = input.bool(false, "Hide weekend sessions (24/7 crypto)", group = G_BOX)
hist_n     = input.int(10, "Sessions kept on chart (per session)", minval = 1, maxval = 100, group = G_BOX, tooltip = "TradingView caps each drawing type at 500 objects. The script lowers this automatically when your settings would exceed the cap (a notice appears in the dashboard).")

// ── Session Lines & Liquidity
mid_all  = input.bool(true, "Midline", inline = "m1", group = G_LIN, tooltip = "First tick = master switch for all midlines. The next three ticks choose the region.")
mid_asia = input.bool(true, "Asia", inline = "m1", group = G_LIN)
mid_eur  = input.bool(true, "Europe", inline = "m1", group = G_LIN)
mid_usa  = input.bool(true, "USA", inline = "m1", group = G_LIN)
hl_all   = input.bool(true, "High/Low", inline = "h1", group = G_LIN, tooltip = "First tick = master switch for all session High/Low lines. The next three ticks choose the region.")
hl_asia  = input.bool(true, "Asia", inline = "h1", group = G_LIN)
hl_eur   = input.bool(true, "Europe", inline = "h1", group = G_LIN)
hl_usa   = input.bool(true, "USA", inline = "h1", group = G_LIN)
px_mid   = input.bool(true, "Midline price", inline = "px1", group = G_LIN)
px_hl    = input.bool(true, "H/L price", inline = "px1", group = G_LIN)
mid_style_s = input.string("Dashed", "Midline style", options = ["Solid", "Dashed", "Dotted"], inline = "ms1", group = G_LIN)
mid_w       = input.int(1, "Width", minval = 1, maxval = 4, inline = "ms1", group = G_LIN)
hl_style_s  = input.string("Solid", "H/L style", options = ["Solid", "Dashed", "Dotted"], inline = "hs1", group = G_LIN)
hl_w        = input.int(1, "Width", minval = 1, maxval = 4, inline = "hs1", group = G_LIN)
ext_mode    = input.string("Until swept", "Carry forward previous H/L", options = ["Until swept", "Until next session", "None"], group = G_LIN, tooltip = "Until swept = liquidity pools stay on the chart until the sweep definition below is met.\nUntil next session = line is cut when the same session starts again.\nNone = no carry forward (line ends with the session).")
show_sweep_mk = input.bool(true, "Mark swept levels with ×", group = G_LIN)
ref_mode    = input.string("Previous Macro Session", "Liquidity reference", options = ["Previous Macro Session", "Previous Same Session", "Both"], group = G_LIN, tooltip = "Reference H/L a session is judged against.\nPrevious Macro Session: Europe uses Asia, USA uses Europe (Europe's H/L so far if it is still running), Asia uses USA.\nPrevious Same Session: the last completed session of the same type.\nBoth: the outer envelope of the two (highest high / lowest low).\nReferences are frozen when the session starts and never use the session's own developing H/L.")
sweep_def   = input.string("Wick Through", "Sweep definition", options = ["Wick Through", "Close Through", "Wick + Rejection", "Wick + Close Back Inside"], group = G_LIN, tooltip = "Wick Through: high/low trades beyond the level.\nClose Through: a bar closes beyond the level.\nWick + Rejection: wick beyond the level and the rejection wick is at least the % below of that bar's range.\nWick + Close Back Inside: wick beyond the level and a bar closes back inside within the max bars below.")
sweep_dist  = input.int(0, "Min sweep distance (ticks)", minval = 0, group = G_LIN, tooltip = "Price must trade (or close) this many ticks beyond a level before it counts.")
rej_pct     = input.int(50, "Min rejection (% of bar range)", minval = 10, maxval = 100, group = G_LIN, tooltip = "Used by 'Wick + Rejection'.")
rej_bars    = input.int(3, "Max bars to confirm rejection", minval = 1, maxval = 20, group = G_LIN, tooltip = "Used by 'Wick + Close Back Inside'. 1 = the same bar must close back inside.")
acc_on      = input.bool(false, "Breakout acceptance", inline = "acc1", group = G_LIN, tooltip = "Tracks whether a close beyond the reference level is accepted (holds) or fails. Adds BRK ACCEPTED / BRK FAILED / RETEST to the liquidity column.")
acc_bars    = input.int(3, "Bars", minval = 1, maxval = 20, inline = "acc1", group = G_LIN, tooltip = "Consecutive closes beyond the level needed for acceptance.")
acc_min     = input.int(0, "Min close beyond level (ticks)", minval = 0, group = G_LIN)
acc_retest  = input.bool(false, "Retest required before acceptance", group = G_LIN, tooltip = "A bar must pull back to the level and still close beyond it before the breakout is accepted.")

// ── Macro Liquidity
show_pd = input.bool(true, "Previous Day H/L", inline = "pd", group = G_MAC)
col_pd  = input.color(#9e9e9e, "", inline = "pd", group = G_MAC)
show_pw = input.bool(true, "Previous Week H/L", inline = "pw", group = G_MAC)
col_pw  = input.color(#cfd8dc, "", inline = "pw", group = G_MAC)
show_pm = input.bool(false, "Previous Month H/L", inline = "pm", group = G_MAC)
col_pm  = input.color(#ffd54f, "", inline = "pm", group = G_MAC)
show_do = input.bool(true, "Daily Open", inline = "do", group = G_MAC)
col_do  = input.color(#26c6da, "", inline = "do", group = G_MAC)
show_wo = input.bool(false, "Weekly Open", inline = "wo", group = G_MAC)
col_wo  = input.color(#ab47bc, "", inline = "wo", group = G_MAC)
show_mo = input.bool(false, "Monthly Open", inline = "mo", group = G_MAC)
col_mo  = input.color(#8d6e63, "", inline = "mo", group = G_MAC)
show_no = input.bool(true, "USA Midnight Open (00:00 NY)", inline = "no", group = G_MAC)
col_no  = input.color(#ffeb3b, "", inline = "no", group = G_MAC)
mac_style_s = input.string("Per level", "Line style", options = ["Per level", "Solid", "Dashed", "Dotted"], inline = "mst", group = G_MAC, tooltip = "Per level keeps the original look: dashed previous-day, solid weekly/monthly, dotted opens.")
lvl_w       = input.int(1, "Width", minval = 1, maxval = 4, inline = "mst", group = G_MAC)
show_mlbl   = input.bool(true, "Labels", inline = "mlb", group = G_MAC)
lbl_off     = input.int(2, "Offset (bars, full-line layout only)", minval = 0, maxval = 50, inline = "mlb", group = G_MAC)
lvl_layout  = input.string("Right strip (gap after last candle)", "Layout", options = ["Right strip (gap after last candle)", "Full line from period start"], group = G_MAC, tooltip = "Right strip: every macro level starts a few bars after the newest (live) candle and runs to the price axis, so it never overlaps the running candle or earlier candles. Scroll the chart left (more empty space on the right) to see it.\nFull line: the original look, a line from the start of the period running through the chart.")
lvl_gap     = input.int(20, "Gap after last candle (bars)", minval = 0, maxval = 100, inline = "lg1", group = G_MAC, tooltip = "Empty bars between the live candle and the start of the level lines. Right-strip layout only.")
lvl_len     = input.int(80, "Strip length (bars)", minval = 2, maxval = 400, inline = "lg1", group = G_MAC, tooltip = "Only used when 'Keep lines going to the price axis' is off: how far the level lines run into the empty space. TradingView allows drawings at most 500 bars into the future, so gap + length can never exceed 500. Right-strip layout only.")
lvl_ext     = input.bool(true, "Keep lines going to the price axis", group = G_MAC, tooltip = "On: each line starts after the gap and runs on to the price axis, however far you scroll right (the reference look). Off: the line stops after the strip length.")
lvl_lbl_pos = input.string("Fixed offset", "Label position (strip)", options = ["Fixed offset", "Line start", "Line end"], inline = "lp", group = G_MAC, tooltip = "Fixed offset: label sits a set number of bars after the live candle, just above its line.\nLine start: label sits just above the first point of the line.\nLine end: label sits after the last point of the line (needs a finite strip; you must scroll right to see it).")
lvl_lbl_gap = input.int(40, "Offset (bars)", minval = 0, maxval = 300, inline = "lp", group = G_MAC, tooltip = "Fixed offset only: distance from the live candle to the label. It is never placed left of the line start.")

// ── Bias / Intelligence
range_bench = input.string("SMA", "Range benchmark", options = ["SMA", "EMA", "Median"], inline = "rb", group = G_BIA, tooltip = "Benchmark session range. Built only from PRIOR completed sessions, never from the session being classified.")
range_len   = input.int(12, "Lookback (sessions)", minval = 3, maxval = 30, inline = "rb", group = G_BIA)
adr_len     = input.int(14, "ADR length (days)", minval = 2, maxval = 60, group = G_BIA)
thr_dead    = input.float(0.40, "DEAD if range / benchmark below", minval = 0.05, maxval = 1.0, step = 0.05, group = G_BIA)
thr_tight   = input.float(0.50, "TIGHT range ratio below", minval = 0.1, maxval = 2.0, step = 0.05, group = G_BIA)
thr_large   = input.float(1.00, "LARGE range ratio from", minval = 0.5, maxval = 3.0, step = 0.05, group = G_BIA)
thr_xtrm    = input.float(1.30, "EXTREME range ratio from", minval = 0.5, maxval = 4.0, step = 0.05, group = G_BIA)
thr_bal     = input.float(0.40, "Balanced if body / range below", minval = 0.1, maxval = 0.9, step = 0.05, group = G_BIA)
thr_body    = input.float(0.50, "Directional if body / range from", minval = 0.1, maxval = 1.0, step = 0.05, group = G_BIA)
thr_clv     = input.float(0.65, "Close-location conviction (0-1)", minval = 0.5, maxval = 1.0, step = 0.05, group = G_BIA)
thr_flow    = input.float(0.05, "Money-flow threshold (+/-)", minval = 0.0, maxval = 0.5, step = 0.01, group = G_BIA)
atr_on   = input.bool(true, "ATR bar volatility", inline = "atr1", group = G_BIA, tooltip = "Per-bar range / ATR, averaged over each session (BAR VOL column). This is bar volatility, separate from session range vs. its own history.")
atr_len  = input.int(14, "Length", minval = 2, maxval = 100, inline = "atr1", group = G_BIA)
atr_dead = input.float(0.50, "Dead <", minval = 0.05, maxval = 2.0, step = 0.05, inline = "atr2", group = G_BIA, tooltip = "Thresholds apply to the session's AVERAGE bar range / ATR. A session below 'Dead' is also classed DEAD.")
atr_high = input.float(1.15, "High >=", minval = 0.5, maxval = 4.0, step = 0.05, inline = "atr2", group = G_BIA)
atr_xt   = input.float(1.50, "Extreme >=", minval = 0.5, maxval = 6.0, step = 0.05, inline = "atr2", group = G_BIA)
adl_on   = input.bool(false, "ADL momentum", inline = "adl1", group = G_BIA, tooltip = "Fast vs. slow average of the accumulation/distribution line. A volume/price-flow heuristic, not proof of anything.")
adl_fast = input.int(9, "Fast", minval = 2, maxval = 100, inline = "adl1", group = G_BIA)
adl_slow = input.int(15, "Slow", minval = 3, maxval = 200, inline = "adl1", group = G_BIA)
div_on   = input.bool(false, "Flow divergence", inline = "dv1", group = G_BIA, tooltip = "Price makes a new extreme while money flow (Chaikin-style) fails to confirm.")
div_lb   = input.int(20, "Lookback", minval = 5, maxval = 100, inline = "dv1", group = G_BIA, tooltip = "Max bars between the two price extremes. Pivot strength is lookback / 5 (min 2).")
div_mag  = input.float(0.05, "Min magnitude", minval = 0.0, maxval = 1.0, step = 0.01, inline = "dv2", group = G_BIA, tooltip = "Minimum flow difference (flow is bounded -1..+1).")
div_piv  = input.bool(true, "Confirmed pivots", inline = "dv2", group = G_BIA, tooltip = "ON: compares confirmed swing pivots (signal arrives pivot-strength bars late, never repaints).\nOFF: compares the bar to the rolling extreme of the lookback.")
div_conf = input.string("Bar Close", "Divergence confirmation", options = ["Intrabar", "Bar Close"], group = G_BIA)
disp_on   = input.bool(false, "Displacement filter", group = G_BIA, tooltip = "A displacement bar has a large body relative to its range AND a large range relative to ATR.")
disp_body = input.float(0.70, "Body / range >=", minval = 0.3, maxval = 1.0, step = 0.05, inline = "dp2", group = G_BIA)
disp_atr  = input.float(1.20, "Range / ATR >=", minval = 0.3, maxval = 5.0, step = 0.05, inline = "dp2", group = G_BIA)
disp_ref  = input.bool(false, "Displacement must close beyond the reference level", group = G_BIA)
str_on    = input.bool(true, "Structure trend", inline = "ss1", group = G_BIA, tooltip = "Persistent HH/HL (or LH/LL) bar runs inside the lookback, not a single candle.")
str_lb    = input.int(20, "Lookback bars", minval = 5, maxval = 100, inline = "ss1", group = G_BIA)
str_up    = input.int(3, "Min HH/HL bars", minval = 1, maxval = 20, inline = "ss2", group = G_BIA)
str_dn    = input.int(3, "Min LH/LL bars", minval = 1, maxval = 20, inline = "ss2", group = G_BIA)
str_ma_on = input.bool(false, "MA filter", inline = "ss3", group = G_BIA)
str_ma_t  = input.string("EMA", "", options = ["SMA", "EMA"], inline = "ss3", group = G_BIA)
str_ma_n  = input.int(50, "Length", minval = 2, maxval = 400, inline = "ss3", group = G_BIA)
req_flow = input.bool(true, "Expansion requires flow", group = G_BIA, tooltip = "Confirmations below only count when their layer is enabled.")
req_adl  = input.bool(false, "Expansion requires ADL agreement", group = G_BIA)
req_disp = input.bool(false, "Expansion requires displacement", group = G_BIA)
req_atr  = input.bool(false, "Expansion requires a high-volatility bar", group = G_BIA)
req_div  = input.bool(false, "Expansion requires no opposing divergence", group = G_BIA)
req_acc  = input.bool(false, "Expansion requires an accepted breakout", group = G_BIA)
req_str  = input.bool(true, "Trend phases require structure", group = G_BIA)

// ── Dashboard
show_dash   = input.bool(true, "Show smart range dashboard", group = G_DSH)
dash_detail = input.string("Standard", "Detail level", options = ["Compact", "Standard", "Advanced"], group = G_DSH, tooltip = "Compact: SESSION / PHASE / LIQUIDITY / BIAS\nStandard: + RANGE / % ADR\nAdvanced: + BAR VOL / FLOW / STRUCTURE")
dash_pos_s  = input.string("Top Right", "Position", options = ["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group = G_DSH)
dash_size_s = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_DSH)
dash_theme  = input.string("Dark", "Theme", options = ["Dark", "Light", "Auto (chart)"], group = G_DSH)

// ── Killzones & Overlap (evaluated in New York time)
show_ovl = input.bool(false, "Highlight Europe x USA overlap", inline = "ovl", group = G_KZ)
col_ovl  = input.color(#ffd600, "", inline = "ovl", group = G_KZ)
show_kz1 = input.bool(false, "Asia KZ", inline = "k1", group = G_KZ)
col_kz1  = input.color(#e91e63, "", inline = "k1", group = G_KZ)
ses_kz1  = input.session("2000-2359", "", inline = "k1", group = G_KZ)
show_kz2 = input.bool(false, "Europe KZ", inline = "k2", group = G_KZ)
col_kz2  = input.color(#2157f3, "", inline = "k2", group = G_KZ)
ses_kz2  = input.session("0200-0500", "", inline = "k2", group = G_KZ)
show_kz3 = input.bool(false, "USA AM KZ", inline = "k3", group = G_KZ)
col_kz3  = input.color(#ff5d00, "", inline = "k3", group = G_KZ)
ses_kz3  = input.session("0700-1000", "", inline = "k3", group = G_KZ)
show_kz4 = input.bool(false, "Europe Close KZ", inline = "k4", group = G_KZ)
col_kz4  = input.color(#00c853, "", inline = "k4", group = G_KZ)
ses_kz4  = input.session("1000-1200", "", inline = "k4", group = G_KZ)

// ── UI & Aesthetics
name_mode      = input.string("City (London / New York)", "Session naming", options = ["Region (Europe / USA)", "City (London / New York)"], group = G_UI, tooltip = "Names used in the dashboard, box tags, price labels and phase labels. Session times are unchanged.")
bg_tr          = input.int(88, "Box fill transparency", minval = 0, maxval = 100, group = G_UI)
show_border    = input.bool(true, "Box borders", inline = "bd1", group = G_UI)
border_w       = input.int(1, "Width", minval = 1, maxval = 4, inline = "bd1", group = G_UI)
border_style_s = input.string("Solid", "Border style", options = ["Solid", "Dashed", "Dotted"], group = G_UI)
show_tag       = input.bool(true, "Session labels", inline = "tg1", group = G_UI)
tag_stats      = input.bool(true, "Range stats in label", inline = "tg1", group = G_UI)
lbl_size_s     = input.string("Small", "Session label size", options = ["Tiny", "Small", "Normal"], group = G_UI)
px_size_s      = input.string("Small", "Price label size", options = ["Tiny", "Small", "Normal"], group = G_UI)
show_bias_lbl  = input.bool(true, "Historical phase labels", inline = "bl1", group = G_UI)
bias_size_s    = input.string("Tiny", "Size", options = ["Tiny", "Small", "Normal"], inline = "bl1", group = G_UI)
col_bull    = input.color(#00e676, "Bullish", inline = "c1", group = G_UI)
col_bear    = input.color(#ff5252, "Bearish", inline = "c1", group = G_UI)
col_info    = input.color(#448aff, "Expansion", inline = "c2", group = G_UI)
col_warn    = input.color(#ffab40, "Warning", inline = "c2", group = G_UI)
col_neutral = input.color(#9e9e9e, "Neutral", inline = "c3", group = G_UI)

// ── Alerts (the new event alerts are sent through alert(): create the alert with condition "Any alert() function call")
alert_mode = input.string("Bar Close", "Alert mode", options = ["Intrabar", "Bar Close"], group = G_ALR, tooltip = "Bar Close = price-based alerts only fire once the bar has closed. Session open/close alerts are time based and always fire on time.")
al_phase = input.bool(false, "Phase change", inline = "al1", group = G_ALR)
al_manip = input.bool(false, "Manipulation up/down", inline = "al1", group = G_ALR)
al_exp   = input.bool(false, "Expansion up/down", inline = "al2", group = G_ALR)
al_sweep = input.bool(false, "High / low / both sweep", inline = "al2", group = G_ALR)
al_acc   = input.bool(false, "Breakout accepted / failed", inline = "al3", group = G_ALR)
al_rng   = input.bool(false, "Session range EXTREME", inline = "al3", group = G_ALR)
al_adr   = input.bool(false, "ADR threshold reached", inline = "al4", group = G_ALR)
adr_thr  = input.int(100, "ADR %", minval = 10, maxval = 300, inline = "al4", group = G_ALR, tooltip = "Session range as % of ADR that triggers the ADR alert.")

// ── Advanced / Engine
sig_mode  = input.string("Intrabar", "Drawing update", options = ["Intrabar", "Bar Close"], group = G_ADV, tooltip = "Controls when session boxes, lines and labels are drawn and updated.\nIntrabar = they follow the forming bar immediately.\nBar Close = they only change when a bar closes.\nThe dashboard and the session state are ALWAYS live on every tick, whatever you choose here.")
flow_mode = input.string("Auto", "Flow data mode", options = ["Auto", "Real Volume", "Tick Volume", "Price Only"], group = G_ADV, tooltip = "Auto uses whatever volume the feed has. Real Volume refuses forex/CFD/index volume (tick counts) and falls back to price-only. Tick Volume labels the volume as tick volume. Price Only ignores volume. The active mode is shown in the dashboard. Volume type is detected from the symbol type, so treat it as a heuristic.")
min_hist  = input.int(3, "Min historical sessions required", minval = 1, maxval = 30, group = G_ADV, tooltip = "Before this many completed sessions exist the phase shows WARM-UP instead of a weak classification.")
ign_part  = input.bool(true, "Ignore incomplete (partial) sessions", group = G_ADV, tooltip = "A session already running on the first loaded bar is incomplete.")
min_bars  = input.int(3, "Min bars per session", minval = 1, maxval = 100, group = G_ADV)
min_q     = input.int(50, "Min data quality (%)", minval = 0, maxval = 100, group = G_ADV, tooltip = "Session bar count vs. the median of previous sessions. Below this the session is ignored (N/A). 0 = off.")
tf_sel    = input.string("All supported", "Enable on", options = ["All supported", "1m-5m", "5m-15m", "15m-1H", "1H-4H"], group = G_ADV)
debug_on  = input.bool(false, "Debug mode", group = G_ADV, tooltip = "Shows a debug table (reference H/L, ratios, flow, sweep and acceptance state, failed confirmations) and start/end markers.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2 · CONSTANTS & DERIVED STYLE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
TZ_SYD = "Australia/Sydney"
TZ_TOK = "Asia/Tokyo"
TZ_SHA = "Asia/Shanghai"
TZ_EUR = "Europe/London"
TZ_USA = "America/New_York"

f_style(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_size(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

f_msty(string dflt) =>
    mac_style_s == "Per level" ? dflt : f_style(mac_style_s)

b_style   = f_style(border_style_s)
mid_sty   = f_style(mid_style_s)
hl_sty    = f_style(hl_style_s)
tag_size  = f_size(lbl_size_s)
px_size   = f_size(px_size_s)
bias_size = f_size(bias_size_s)
dash_tsz  = f_size(dash_size_s)
dash_pos = dash_pos_s == "Top Left" ? position.top_left : dash_pos_s == "Top Center" ? position.top_center : dash_pos_s == "Top Right" ? position.top_right : dash_pos_s == "Middle Left" ? position.middle_left : dash_pos_s == "Middle Right" ? position.middle_right : dash_pos_s == "Bottom Left" ? position.bottom_left : dash_pos_s == "Bottom Center" ? position.bottom_center : position.bottom_right
dash_hdr_bg = dash_theme == "Light" ? #e0e3eb : dash_theme == "Auto (chart)" ? color.new(chart.fg_color, 85) : #000000
dash_row_bg = dash_theme == "Light" ? #ffffff : dash_theme == "Auto (chart)" ? chart.bg_color : #1e222d
dash_txt    = dash_theme == "Light" ? #131722 : dash_theme == "Auto (chart)" ? chart.fg_color : #d1d4dc

// Macro level layout
bool lvl_strip = lvl_layout == "Right strip (gap after last candle)"

// Session naming: Europe / USA by default, London / New York optional
bool   nm_city = name_mode == "City (London / New York)"
// Dashboard, midlines, H/L lines, price labels and alerts always use Asia / Europe / USA.
string nm_eur  = "Europe"
string nm_usa  = "USA"
string pf_eur  = "EU"
string pf_usa  = "US"
// Only the box tag follows the naming setting.
string bx_eur  = nm_city ? "London" : "Europe"
string bx_usa  = nm_city ? "New York" : "USA"

// Effective per-region line toggles (master AND region)
bool e_mid_asia = mid_all and mid_asia
bool e_mid_eur  = mid_all and mid_eur
bool e_mid_usa  = mid_all and mid_usa
bool e_hl_asia  = hl_all and hl_asia
bool e_hl_eur   = hl_all and hl_eur
bool e_hl_usa   = hl_all and hl_usa

// Timeframe gate
int tf_secs = timeframe.in_seconds()
bool tf_sel_ok = switch tf_sel
    "1m-5m"  => tf_secs >= 60 and tf_secs <= 300
    "5m-15m" => tf_secs >= 300 and tf_secs <= 900
    "15m-1H" => tf_secs >= 900 and tf_secs <= 3600
    "1H-4H"  => tf_secs >= 3600 and tf_secs <= 14400
    => tf_secs <= 14400
bool tf_ok     = timeframe.isintraday and tf_sel_ok
bool tf_coarse = tf_secs > 3600
string tf_msg  = not timeframe.isintraday ? "Sessions need an intraday chart (4H or lower)" : "Disabled on this timeframe (Enable on: " + tf_sel + ")"

// Drawing budget: TradingView allows 500 boxes, 500 lines and 500 labels. The tightest one decides how many sessions fit.
int n_mid = (e_mid_asia ? 1 : 0) + (e_mid_eur ? 1 : 0) + (e_mid_usa ? 1 : 0)
int n_hl  = (e_hl_asia ? 1 : 0) + (e_hl_eur ? 1 : 0) + (e_hl_usa ? 1 : 0)
int n_box = (merge_asia ? ((show_syd or show_tok or show_sha) ? 1 : 0) : (show_syd ? 1 : 0) + (show_tok ? 1 : 0) + (show_sha ? 1 : 0)) + (show_eur ? 1 : 0) + (show_usa ? 1 : 0)
int box_per_hist = math.max(1, n_box)
int lin_per_hist = math.max(1, n_mid + 2 * n_hl)
int lbl_per_hist = math.max(1, (show_tag ? n_box : 0) + (px_mid ? n_mid : 0) + (px_hl ? 2 * n_hl : 0) + (show_bias_lbl ? 3 : 0) + (show_sweep_mk ? 2 * n_hl : 0))
int hist_eff = math.max(1, math.min(hist_n, math.min(int(math.floor(490.0 / box_per_hist)), math.min(int(math.floor(485.0 / lin_per_hist)), int(math.floor(485.0 / lbl_per_hist))))))
bool hist_clamped = hist_eff < hist_n
int hist_need = math.min(min_hist, range_len)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3 · TIME / SESSION DETECTION (all calls run on every bar)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_in_sess(string sess, string tz) =>
    bool inside = not na(time(timeframe.period, sess, tz))
    bool wk_ok  = true
    if skip_wknd
        int dw = dayofweek(time, tz)
        wk_ok := dw != dayofweek.saturday and dw != dayofweek.sunday
    inside and wk_ok

bool act_syd  = tf_ok and f_in_sess(ses_syd, TZ_SYD)
bool act_tok  = tf_ok and f_in_sess(ses_tok, TZ_TOK)
bool act_sha  = tf_ok and f_in_sess(ses_sha, TZ_SHA)
bool act_eur  = tf_ok and f_in_sess(ses_eur, TZ_EUR)
bool act_usa  = tf_ok and f_in_sess(ses_usa, TZ_USA)
bool act_asia = act_syd or act_tok or act_sha

// Only build drawings for the window that can actually remain on screen
int  draw_ms = int((hist_eff * 1.6 + 4) * 86400000)
bool draw_ok = time >= last_bar_time - draw_ms
int  t_prev  = nz(time[1], time)
int  tf_ms   = tf_secs * 1000
float NA_F   = na

// Drawing gate. The session engine itself advances on EVERY tick (TradingView rolls realtime state back on each tick,
// so the committed result is identical to a closed-bar run, and the dashboard is always live).
// This gate only decides when boxes / lines / labels are created or changed.
bool draw_step = sig_mode == "Intrabar" or barstate.isconfirmed
bool alert_ok  = alert_mode == "Intrabar" or barstate.isconfirmed

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4 · MARKET-FLOW / VOLATILITY / STRUCTURE ENGINES (series, computed once per bar)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
float rng_bar = high - low
float mfm     = rng_bar > 0 ? ((close - low) - (high - close)) / rng_bar : 0.0

// Flow data mode: volume is used only when it exists; otherwise every bar weighs 1.0 (price-only flow)
bool   feed_tick = syminfo.type == "forex" or syminfo.type == "cfd" or syminfo.type == "index"
bool   vol_ok    = nz(volume) > 0
bool   use_vol   = vol_ok and (flow_mode == "Tick Volume" or flow_mode == "Auto" or (flow_mode == "Real Volume" and not feed_tick))
float  vol_eff   = use_vol ? volume : 1.0
string flow_lbl  = not use_vol ? "PRICE ONLY" : (flow_mode == "Tick Volume" or (flow_mode == "Auto" and feed_tick)) ? "TICK VOL" : "REAL VOL"

// ATR bar volatility (bar range / ATR). Not the same thing as session range vs. session history.
float atr_v  = ta.atr(atr_len)
float bar_rt = atr_v > 0 ? rng_bar / atr_v : na

// Displacement: large body/range AND large range/ATR on the same bar
float body_bar    = math.abs(close - open)
bool  disp_core   = disp_on and rng_bar > 0 and body_bar / rng_bar >= disp_body and not na(bar_rt) and bar_rt >= disp_atr
bool  disp_up_bar = disp_core and close > open
bool  disp_dn_bar = disp_core and close < open

// ADL momentum (volume/price-flow heuristic)
float adl_raw  = ta.cum(mfm * vol_eff)
float adl_f    = ta.sma(adl_raw, adl_fast)
float adl_s    = ta.sma(adl_raw, adl_slow)
float adl_band = 0.1 * nz(ta.stdev(adl_f - adl_s, 50))
int   adl_dir  = (adl_f - adl_s) > adl_band ? 1 : (adl_f - adl_s) < -adl_band ? -1 : 0

// Bounded money-flow oscillator (-1..+1) used for divergence (zero-volume safe)
float cmf_num = ta.sma(mfm * vol_eff, div_lb)
float cmf_den = ta.sma(vol_eff, div_lb)
float cmf     = na(cmf_den) ? na : (cmf_den > 0 ? cmf_num / cmf_den : 0.0)

// Price / flow divergence. Pivot mode only uses confirmed pivots, so it cannot repaint.
int   div_pn    = math.max(2, int(div_lb / 5))
float pvt_hi    = ta.pivothigh(high, div_pn, div_pn)
float pvt_lo    = ta.pivotlow(low, div_pn, div_pn)
float cmf_pv    = cmf[div_pn]
float roll_hh   = ta.highest(high, div_lb)[1]
float roll_ll   = ta.lowest(low, div_lb)[1]
float roll_cmx  = ta.highest(cmf, div_lb)[1]
float roll_cmn  = ta.lowest(cmf, div_lb)[1]
var float pvh_px  = na
var float pvh_cm  = na
var int   pvh_bar = na
var float pvl_px  = na
var float pvl_cm  = na
var int   pvl_bar = na
bool dv_bear_raw = false
bool dv_bull_raw = false
if div_on
    if div_piv
        if not na(pvt_hi)
            int pb = bar_index - div_pn
            if not na(pvh_px) and not na(pvh_cm) and not na(cmf_pv) and pb - pvh_bar <= div_lb and pvt_hi > pvh_px and cmf_pv < pvh_cm - div_mag
                dv_bear_raw := true
            pvh_px  := pvt_hi
            pvh_cm  := cmf_pv
            pvh_bar := pb
        if not na(pvt_lo)
            int pb2 = bar_index - div_pn
            if not na(pvl_px) and not na(pvl_cm) and not na(cmf_pv) and pb2 - pvl_bar <= div_lb and pvt_lo < pvl_px and cmf_pv > pvl_cm + div_mag
                dv_bull_raw := true
            pvl_px  := pvt_lo
            pvl_cm  := cmf_pv
            pvl_bar := pb2
    else
        dv_bear_raw := high > roll_hh and cmf < roll_cmx - div_mag
        dv_bull_raw := low < roll_ll and cmf > roll_cmn + div_mag
bool div_ok       = div_conf == "Intrabar" or barstate.isconfirmed
bool div_bear_evt = div_ok and dv_bear_raw
bool div_bull_evt = div_ok and dv_bull_raw

// Structure trend: persistent HH/HL (or LH/LL) bar runs inside the lookback. Inside bars keep the run alive.
bool bull_bar = high > high[1] and low > low[1]
bool bear_bar = high < high[1] and low < low[1]
var float bull_run = 0.0
var float bear_run = 0.0
if bull_bar
    bull_run := bull_run + 1.0
    bear_run := 0.0
else if bear_bar
    bear_run := bear_run + 1.0
    bull_run := 0.0
float up_pk  = ta.highest(bull_run, str_lb)
float dn_pk  = ta.highest(bear_run, str_lb)
float ma_e   = ta.ema(close, str_ma_n)
float ma_s   = ta.sma(close, str_ma_n)
float str_ma = str_ma_t == "EMA" ? ma_e : ma_s
int str_dir  = (up_pk >= str_up and up_pk > dn_pk and (not str_ma_on or close > str_ma)) ? 1 : (dn_pk >= str_dn and dn_pk > up_pk and (not str_ma_on or close < str_ma)) ? -1 : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5 · HIGHER-TIMEFRAME DATA
//   CONFIRMED  : [1] + lookahead_on returns the last COMPLETED higher-timeframe bar (no repaint, no future leak).
//                The higher-timeframe OPEN is known at the start of its period, so it is safe too.
//   DEVELOPING : today's high/low is built locally from chart bars (dev_hi / dev_lo). It grows during the day
//                and is a live value, not a confirmed one.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[pdh, pdl, d_open, adr] = request.security(syminfo.tickerid, "D", [high[1], low[1], open, ta.sma(high - low, adr_len)[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl, w_open]      = request.security(syminfo.tickerid, "W", [high[1], low[1], open], lookahead = barmerge.lookahead_on)
[pmh, pml, m_open]      = request.security(syminfo.tickerid, "M", [high[1], low[1], open], lookahead = barmerge.lookahead_on)

int  t_d = nz(time("D"), time)
int  t_w = nz(time("W"), time)
int  t_m = nz(time("M"), time)
bool new_day = nz(ta.change(t_d)) != 0
var float dev_hi = na
var float dev_lo = na
if new_day or na(dev_hi)
    dev_hi := high
    dev_lo := low
else
    dev_hi := math.max(dev_hi, high)
    dev_lo := math.min(dev_lo, low)

int  ny_dom     = dayofmonth(time, TZ_USA)
bool new_ny_day = nz(ta.change(ny_dom)) != 0
var float ny_open   = na
var int   ny_open_t = na
if new_ny_day
    ny_open   := open
    ny_open_t := time

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6 · TYPES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// One Side tracks the state of ONE price level. Used for reference H/L (classification)
// and for a finished session's own H/L (line lifecycle).
type Side
    bool touched  = false
    bool swept    = false     // liquidity taken per the chosen sweep definition
    int  arm_bar  = -1        // 'Wick + Close Back Inside': -1 idle · >=0 armed at bar · -2 expired
    int  brk      = 0         // breakout: 0 none · 1 pending · 2 accepted · 3 failed
    int  n_beyond = 0
    bool retested = false
    int  life     = 0         // H/L line lifecycle: 0 live · 1 carried forward · 2 stopped (swept / cut)

type Sess
    string nm
    string pfx
    color  col
    bool   live     = false
    bool   drawn    = false
    bool   partial  = false
    bool   valid    = true
    int    t0
    int    t1
    int    nbars    = 0
    float  px_o
    float  hi
    float  lo
    float  px_c
    float  mfv      = 0.0
    float  vsum     = 0.0
    float  vol      = 0.0
    float  atr_sum  = 0.0
    int    atr_n    = 0
    float  atr_pk   = 0.0
    float  avg
    float  exp_n               // typical bar count of previous sessions (used to recognise a session that is still forming)
    float  adr
    float  ref_hi
    float  ref_lo
    int    adl_dir  = 0
    int    str_dir  = 0
    bool   disp_up  = false
    bool   disp_dn  = false
    bool   div_bull = false
    bool   div_bear = false
    float  rng
    float  rt
    float  body_r
    float  clv
    float  flow
    float  adr_u
    float  atr_rt
    int    dirn     = 0
    string phase    = "—"
    color  phase_col
    int    dir      = 0
    string liq      = "—"
    color  liq_col
    string why      = ""
    string ph_live  = "—"
    bool   rng_fired = false
    bool   adr_fired = false
    Side   rh
    Side   rl
    Side   oh
    Side   ol
    box    bx
    label  tag
    line   ln_mid
    label  lb_mid
    line   ln_h
    line   ln_l
    label  lb_h
    label  lb_l
    label  lb_bias
    label  mk_h
    label  mk_l

type Track
    string       nm
    string       pfx
    color        col
    array<Sess>  sess
    array<float> rngs
    array<float> nbs
    float        last_hi
    float        last_lo

type Lvl
    line  ln
    label lb

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7 · HELPERS: FORMATTING, NULL-SAFE SETTERS, EVENTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var array<string> ev_q = array.new<string>()

f_ev(string who, string kind) =>
    if barstate.isrealtime
        array.push(ev_q, who + " | " + kind)
    true

f_rng(float r) =>
    syminfo.type == "forex" ? str.tostring(r / (syminfo.mintick * 10), "0.0") + "p" : str.tostring(r, format.mintick)

f_rng_class(float rt) =>
    string tx = "—"
    color  cl = dash_txt
    if not na(rt)
        if rt < thr_tight
            tx := "TIGHT"
            cl := col_neutral
        else if rt < thr_large
            tx := "NORMAL"
            cl := dash_txt
        else if rt < thr_xtrm
            tx := "LARGE"
            cl := col_warn
        else
            tx := "EXTREME"
            cl := col_bear
    [tx, cl]

f_vol_cls(float x) =>
    string tx = "NORMAL"
    color  cl = dash_txt
    if x < atr_dead
        tx := "DEAD"
        cl := col_neutral
    else if x >= atr_xt
        tx := "EXTREME"
        cl := col_bear
    else if x >= atr_high
        tx := "HIGH"
        cl := col_warn
    [tx, cl]

f_box(box b, int l, float tp, int r, float bt) =>
    if not na(b)
        box.set_left(b, l)
        box.set_top(b, tp)
        box.set_right(b, r)
        box.set_bottom(b, bt)

f_ln(line ln, int x1, float y, int x2) =>
    if not na(ln)
        line.set_xy1(ln, x1, y)
        line.set_xy2(ln, x2, y)

f_lb(label lb, int x, float y, string tx) =>
    if not na(lb)
        label.set_xy(lb, x, y)
        label.set_text(lb, tx)

// delete every drawing a session owns and release the references
f_del(Sess s) =>
    box.delete(s.bx)
    label.delete(s.tag)
    line.delete(s.ln_mid)
    label.delete(s.lb_mid)
    line.delete(s.ln_h)
    line.delete(s.ln_l)
    label.delete(s.lb_h)
    label.delete(s.lb_l)
    label.delete(s.lb_bias)
    label.delete(s.mk_h)
    label.delete(s.mk_l)
    s.bx      := na
    s.tag     := na
    s.ln_mid  := na
    s.lb_mid  := na
    s.ln_h    := na
    s.ln_l    := na
    s.lb_h    := na
    s.lb_l    := na
    s.lb_bias := na
    s.mk_h    := na
    s.mk_l    := na
    true

// stop a session's carried-forward H/L at x (used by "Until next session")
f_cut(Sess s, int x) =>
    Side ch = s.oh
    Side cl = s.ol
    if not na(s.ln_h) and ch.life == 1
        line.set_extend(s.ln_h, extend.none)
        line.set_x2(s.ln_h, x)
        ch.life := 2
    if not na(s.ln_l) and cl.life == 1
        line.set_extend(s.ln_l, extend.none)
        line.set_x2(s.ln_l, x)
        cl.life := 2
    true

// benchmark of PRIOR completed session ranges (SMA / EMA / Median)
f_bench(array<float> a) =>
    int   n = array.size(a)
    float r = na
    if n > 0
        if range_bench == "Median"
            r := array.median(a)
        else if range_bench == "EMA"
            r := array.get(a, 0)
            if n > 1
                float k = 2.0 / (n + 1.0)
                for i = 1 to n - 1
                    r := r + k * (array.get(a, i) - r)
        else
            r := array.avg(a)
    r

// reference level from the configured liquidity reference mode
f_ref(float macro, float same, bool want_hi) =>
    float r = na
    if ref_mode == "Previous Macro Session"
        r := macro
    else if ref_mode == "Previous Same Session"
        r := same
    else
        r := na(macro) ? same : na(same) ? macro : (want_hi ? math.max(macro, same) : math.min(macro, same))
    r

// latest H or L of a track (live or finished), read BEFORE this bar updates any session
f_lat(Track t, bool want_hi) =>
    float r = na
    if array.size(t.sess) > 0
        Sess s = array.last(t.sess)
        r := want_hi ? s.hi : s.lo
    r

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8 · LIQUIDITY STATE MACHINE
//   Level states: INSIDE → TOUCHED → SWEPT (per definition) → TRAP (rejected) | BREAKOUT → ACCEPTED | FAILED (+RETEST)
//   Line lifecycle: CREATED (live) → EXTENDED (life 1) → SWEPT / NEXT-SESSION CUTOFF → STOPPED (life 2)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// true on the bar where liquidity at `lvl` is taken, according to the sweep definition
f_sweep_hit(Side sd, float lvl, bool up) =>
    float d    = up ? 1.0 : -1.0
    float dist = sweep_dist * syminfo.mintick
    float ex_w = ((up ? high : low) - lvl) * d
    float ex_c = (close - lvl) * d
    float rj   = (up ? high - close : close - low) / math.max(high - low, syminfo.mintick)
    bool  wick = ex_w > dist
    bool  hit  = false
    if sweep_def == "Wick Through"
        hit := wick
    else if sweep_def == "Close Through"
        hit := ex_c > dist
    else if sweep_def == "Wick + Rejection"
        hit := wick and rj >= rej_pct / 100.0
    else
        if sd.arm_bar == -2 and ex_c <= 0
            sd.arm_bar := -1
        if wick and sd.arm_bar == -1
            sd.arm_bar := bar_index
        if sd.arm_bar >= 0
            if ex_c <= 0
                hit := true
            else if bar_index - sd.arm_bar >= rej_bars - 1
                sd.arm_bar := -2
    hit

// breakout acceptance: a close beyond the level is accepted (holds) or fails (closes back inside)
f_brk_step(Side sd, float lvl, bool up, string who) =>
    float d      = up ? 1.0 : -1.0
    float exc    = (close - lvl) * d
    bool  beyond = exc > acc_min * syminfo.mintick
    bool  inside = exc <= 0
    float tol    = 0.1 * nz(atr_v)
    bool  rt_bar = ((up ? low : high) - lvl) * d <= tol
    int   prev   = sd.brk
    if sd.brk == 0 or sd.brk == 3
        if beyond
            sd.brk := 1
            sd.n_beyond := 1
            sd.retested := false
    else if sd.brk == 1
        if inside
            sd.brk := 3
        else if beyond
            sd.n_beyond := sd.n_beyond + 1
            if rt_bar and sd.n_beyond > 1
                sd.retested := true
    else if sd.brk == 2
        if inside
            sd.brk := 3
    if sd.brk == 1 and sd.n_beyond >= acc_bars and (not acc_retest or sd.retested)
        sd.brk := 2
    if sd.brk != prev and al_acc
        if sd.brk == 2
            f_ev(who, "Breakout ACCEPTED " + (up ? "above reference high " : "below reference low ") + str.tostring(lvl, format.mintick))
        if sd.brk == 3
            f_ev(who, "Breakout FAILED " + (up ? "above reference high " : "below reference low ") + str.tostring(lvl, format.mintick))
    true

// one bar of interaction between a live session and its (frozen) reference H/L
f_ref_step(Sess s) =>
    if not na(s.ref_hi) and not na(s.ref_lo)
        Side h = s.rh
        Side l = s.rl
        bool was_h = h.swept
        bool was_l = l.swept
        if not h.swept
            if f_sweep_hit(h, s.ref_hi, true)
                h.swept := true
        if not l.swept
            if f_sweep_hit(l, s.ref_lo, false)
                l.swept := true
        if high >= s.ref_hi
            h.touched := true
        if low <= s.ref_lo
            l.touched := true
        if acc_on
            f_brk_step(h, s.ref_hi, true, s.nm)
            f_brk_step(l, s.ref_lo, false, s.nm)
        bool new_h = h.swept and not was_h
        bool new_l = l.swept and not was_l
        if al_sweep and (new_h or new_l)
            if h.swept and l.swept
                f_ev(s.nm, "Both-side sweep (reference high and low taken)")
            else if new_h
                f_ev(s.nm, "High sweep (reference high " + str.tostring(s.ref_hi, format.mintick) + ")")
            else
                f_ev(s.nm, "Low sweep (reference low " + str.tostring(s.ref_lo, format.mintick) + ")")
    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9 · SESSION METRICS + PHASE CLASSIFIER
//   Both read the session's STORED values only. Reference H/L live in ref_hi / ref_lo, never in hi / lo.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_calc(Sess s) =>
    float rr   = s.hi - s.lo
    float rr_s = math.max(rr, syminfo.mintick)
    s.rng    := rr
    s.rt     := (not na(s.avg) and s.avg > 0) ? rr / s.avg : na
    s.body_r := math.abs(s.px_c - s.px_o) / rr_s
    s.clv    := (s.px_c - s.lo) / rr_s
    s.dirn   := s.px_c > s.px_o ? 1 : s.px_c < s.px_o ? -1 : 0
    s.flow   := s.vsum > 0 ? s.mfv / s.vsum : 0.0
    s.adr_u  := (not na(s.adr) and s.adr > 0) ? rr / s.adr : na
    s.atr_rt := s.atr_n > 0 ? s.atr_sum / s.atr_n : na
    true

// phase hierarchy: DEAD > MANIPULATION > EXPANSION > DISTRIBUTION > ACCUMULATION > TREND > CONSOLIDATION
// A live session whose range is still building cannot be called DEAD (it shows FORMING instead of CONSOLIDATION).
f_classify(Sess s) =>
    string ph  = "CONSOLIDATION"
    color  pc  = col_neutral
    int    bd  = 0
    string why = ""
    if na(s.avg)
        ph := "WARM-UP"
    else
        float rt      = na(s.rt) ? 1.0 : s.rt
        bool  has_ref = not na(s.ref_hi) and not na(s.ref_lo)
        Side  rh      = s.rh
        Side  rl      = s.rl
        bool  sw_h    = has_ref and rh.swept
        bool  sw_l    = has_ref and rl.swept
        bool  trap_h  = sw_h and s.px_c < s.ref_hi and s.clv < 0.5
        bool  trap_l  = sw_l and s.px_c > s.ref_lo and s.clv > 0.5
        bool  brk_up  = has_ref and s.px_c > s.ref_hi and s.body_r >= thr_body and s.clv >= thr_clv
        bool  brk_dn  = has_ref and s.px_c < s.ref_lo and s.body_r >= thr_body and s.clv <= 1.0 - thr_clv
        bool  f_bull  = s.flow > thr_flow
        bool  f_bear  = s.flow < -thr_flow
        bool  balanced = s.body_r < thr_bal
        bool  forming  = s.live and (s.nbars < 2 or (not na(s.exp_n) and s.nbars < 0.25 * s.exp_n))
        // optional confirmations: each only counts when its layer is enabled AND set to required
        bool ok_flow_up = not req_flow or f_bull
        bool ok_flow_dn = not req_flow or f_bear
        bool ok_adl_up  = not (adl_on and req_adl) or s.adl_dir > 0
        bool ok_adl_dn  = not (adl_on and req_adl) or s.adl_dir < 0
        bool ok_disp_up = not (disp_on and req_disp) or s.disp_up
        bool ok_disp_dn = not (disp_on and req_disp) or s.disp_dn
        bool ok_atr     = not (atr_on and req_atr) or s.atr_pk >= atr_high
        bool ok_div_up  = not (div_on and req_div) or not s.div_bear
        bool ok_div_dn  = not (div_on and req_div) or not s.div_bull
        bool ok_acc_up  = not (acc_on and req_acc) or rh.brk == 2
        bool ok_acc_dn  = not (acc_on and req_acc) or rl.brk == 2
        bool ok_str_up  = not (str_on and req_str) or s.str_dir > 0
        bool ok_str_dn  = not (str_on and req_str) or s.str_dir < 0
        bool dead = not forming and (rt < thr_dead or (atr_on and not na(s.atr_rt) and s.atr_rt < atr_dead))
        if dead
            ph := "DEAD"
        else if trap_h and (f_bear or s.clv < 0.3)
            ph := "MANIPULATION ↓"
            pc := col_bear
            bd := -1
        else if trap_l and (f_bull or s.clv > 0.7)
            ph := "MANIPULATION ↑"
            pc := col_bull
            bd := 1
        else if brk_up and ok_flow_up and ok_adl_up and ok_disp_up and ok_atr and ok_div_up and ok_acc_up
            ph := "EXPANSION ↑"
            pc := col_info
            bd := 1
        else if brk_dn and ok_flow_dn and ok_adl_dn and ok_disp_dn and ok_atr and ok_div_dn and ok_acc_dn
            ph := "EXPANSION ↓"
            pc := col_info
            bd := -1
        else if balanced and rt >= thr_large and f_bear
            ph := "DISTRIBUTION"
            pc := col_warn
            bd := -1
        else if balanced and rt < thr_large and f_bull
            ph := "ACCUMULATION"
            pc := col_bull
            bd := 1
        else if s.body_r >= thr_body and s.dirn > 0 and s.clv >= thr_clv and ok_str_up
            ph := "BULL TREND"
            pc := col_bull
            bd := 1
        else if s.body_r >= thr_body and s.dirn < 0 and s.clv <= 1.0 - thr_clv and ok_str_dn
            ph := "BEAR TREND"
            pc := col_bear
            bd := -1
        if forming and ph == "CONSOLIDATION"
            ph := "FORMING"
        // confirmation failures (debug): a breakout was present but a required filter said no
        if (brk_up or brk_dn) and ph != "EXPANSION ↑" and ph != "EXPANSION ↓"
            bool u = brk_up
            string w = ""
            if not (u ? ok_flow_up : ok_flow_dn)
                w := w + "flow "
            if not (u ? ok_adl_up : ok_adl_dn)
                w := w + "adl "
            if not (u ? ok_disp_up : ok_disp_dn)
                w := w + "disp "
            if not ok_atr
                w := w + "atr "
            if not (u ? ok_div_up : ok_div_dn)
                w := w + "div "
            if not (u ? ok_acc_up : ok_acc_dn)
                w := w + "accept "
            why := w
    [ph, pc, bd, why]

// liquidity column: deterministic hierarchy
// ACCEPTED > FAILED > TRAP > RETEST > BREAKOUT > SWEPT H+L > SWEPT > TOUCHED > INSIDE
f_liq(Sess s) =>
    string tx = "—"
    color  cl = col_neutral
    if not na(s.ref_hi) and not na(s.ref_lo)
        Side h = s.rh
        Side l = s.rl
        bool trap_h = h.swept and s.px_c < s.ref_hi and s.clv < 0.5
        bool trap_l = l.swept and s.px_c > s.ref_lo and s.clv > 0.5
        bool bo_up  = s.px_c > s.ref_hi
        bool bo_dn  = s.px_c < s.ref_lo
        tx := "INSIDE"
        if h.brk == 2
            tx := "BRK ↑ ACCEPTED"
            cl := col_bull
        else if l.brk == 2
            tx := "BRK ↓ ACCEPTED"
            cl := col_bear
        else if h.brk == 3
            tx := "BRK ↑ FAILED"
            cl := col_bear
        else if l.brk == 3
            tx := "BRK ↓ FAILED"
            cl := col_bull
        else if trap_h
            tx := "TRAP HIGH"
            cl := col_bear
        else if trap_l
            tx := "TRAP LOW"
            cl := col_bull
        else if h.brk == 1 and h.retested
            tx := "RETEST ↑"
            cl := col_info
        else if l.brk == 1 and l.retested
            tx := "RETEST ↓"
            cl := col_info
        else if bo_up
            tx := "BREAKOUT ↑"
            cl := col_info
        else if bo_dn
            tx := "BREAKOUT ↓"
            cl := col_info
        else if h.swept and l.swept
            tx := "SWEPT H+L"
            cl := col_warn
        else if h.swept
            tx := "SWEPT HIGH"
            cl := col_warn
        else if l.swept
            tx := "SWEPT LOW"
            cl := col_warn
        else if h.touched
            tx := "HIGH TOUCHED"
            cl := col_warn
        else if l.touched
            tx := "LOW TOUCHED"
            cl := col_warn
    [tx, cl]

// phase-change style events (only queued in realtime, only when the matching alert is enabled)
f_phase_ev(Sess s, string oldp, string newp) =>
    if barstate.isrealtime and newp != oldp
        if al_phase
            f_ev(s.nm, "Phase change: " + oldp + " → " + newp)
        if al_manip and newp == "MANIPULATION ↑"
            f_ev(s.nm, "Bullish manipulation")
        if al_manip and newp == "MANIPULATION ↓"
            f_ev(s.nm, "Bearish manipulation")
        if al_exp and newp == "EXPANSION ↑"
            f_ev(s.nm, "Expansion up")
        if al_exp and newp == "EXPANSION ↓"
            f_ev(s.nm, "Expansion down")
    true

// developing classification of a live session (last bar only: dashboard + live alerts)
f_live_eval(Sess s) =>
    f_calc(s)
    [ph, pc, bd, why] = f_classify(s)
    [lq, lc] = f_liq(s)
    f_phase_ev(s, s.ph_live, ph)
    s.ph_live   := ph
    s.phase     := ph
    s.phase_col := pc
    s.dir       := bd
    s.liq       := lq
    s.liq_col   := lc
    s.why       := why
    if al_rng and not s.rng_fired and not na(s.rt) and s.rt >= thr_xtrm
        s.rng_fired := true
        f_ev(s.nm, "Session range EXTREME (" + str.tostring(s.rt, "0.00") + "x benchmark)")
    if al_adr and not s.adr_fired and not na(s.adr_u) and s.adr_u * 100 >= adr_thr
        s.adr_fired := true
        f_ev(s.nm, "ADR threshold reached (" + str.tostring(s.adr_u * 100, "#") + "% of ADR)")
    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 10 · DRAWING ENGINE: CREATE ONCE, THEN UPDATE WITH SETTERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_bnm(Sess s) =>
    s.nm == "Europe" ? bx_eur : s.nm == "USA" ? bx_usa : s.nm



f_create(Sess s, bool box_on, bool mid_on, bool hl_on) =>
    color bc = show_border ? s.col : color.new(s.col, 100)
    if box_on
        s.bx := box.new(s.t0, s.hi, s.t0, s.lo, xloc = xloc.bar_time, border_color = bc, border_style = b_style, border_width = border_w, bgcolor = color.new(s.col, bg_tr))
        if show_tag
            s.tag := label.new(s.t0, s.hi, f_bnm(s), xloc = xloc.bar_time, style = label.style_label_lower_left, color = s.col, textcolor = color.white, size = tag_size)
    if mid_on
        s.ln_mid := line.new(s.t0, s.px_o, s.t0, s.px_o, xloc = xloc.bar_time, color = color.new(s.col, 30), style = mid_sty, width = mid_w)
        if px_mid
            s.lb_mid := label.new(s.t0, s.px_o, "", xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(s.col, 100), textcolor = s.col, size = px_size)
    if hl_on
        s.ln_h := line.new(s.t0, s.hi, s.t0, s.hi, xloc = xloc.bar_time, color = s.col, style = hl_sty, width = hl_w)
        s.ln_l := line.new(s.t0, s.lo, s.t0, s.lo, xloc = xloc.bar_time, color = s.col, style = hl_sty, width = hl_w)
        if px_hl
            s.lb_h := label.new(s.t0, s.hi, "", xloc = xloc.bar_time, style = label.style_label_lower_right, color = color.new(s.col, 100), textcolor = s.col, size = px_size)
            s.lb_l := label.new(s.t0, s.lo, "", xloc = xloc.bar_time, style = label.style_label_upper_right, color = color.new(s.col, 100), textcolor = s.col, size = px_size)
    true

f_update(Sess s, int right_t) =>
    float rr  = s.hi - s.lo
    float mid = (s.hi + s.lo) / 2
    float rtt = (not na(s.avg) and s.avg > 0) ? rr / s.avg : na
    f_box(s.bx, s.t0, s.hi, right_t, s.lo)
    if not na(s.tag)
        string tx = f_bnm(s)
        if tag_stats
            tx := tx + "  ·  " + f_rng(rr) + (na(rtt) ? "" : "  ·  " + str.tostring(rtt, "0.0") + "×")
        label.set_xy(s.tag, s.t0, s.hi)
        label.set_text(s.tag, tx)
    f_ln(s.ln_mid, s.t0, mid, right_t)
    f_lb(s.lb_mid, s.t0, mid, s.pfx + " EQ " + str.tostring(mid, format.mintick))
    f_ln(s.ln_h, s.t0, s.hi, right_t)
    f_ln(s.ln_l, s.t0, s.lo, right_t)
    f_lb(s.lb_h, right_t, s.hi, s.pfx + " H " + str.tostring(s.hi, format.mintick))
    f_lb(s.lb_l, right_t, s.lo, s.pfx + " L " + str.tostring(s.lo, format.mintick))
    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 11 · SESSION STATE ENGINE (start → live update → freeze → classify)
//   The state advances on every tick, so the dashboard is always current.
//   Only the drawing calls are gated by draw_step (Drawing update setting).
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// one active bar added to a live session
f_bar(Sess cs, bool stats_on) =>
    cs.hi    := math.max(cs.hi, high)
    cs.lo    := math.min(cs.lo, low)
    cs.px_c  := close
    cs.t1    := time
    cs.nbars := cs.nbars + 1
    cs.mfv   := cs.mfv + mfm * vol_eff
    cs.vsum  := cs.vsum + vol_eff
    cs.vol   := cs.vol + nz(volume)
    if not na(bar_rt)
        cs.atr_sum := cs.atr_sum + bar_rt
        cs.atr_n   := cs.atr_n + 1
        cs.atr_pk  := math.max(cs.atr_pk, bar_rt)
    cs.adl_dir := adl_dir
    cs.str_dir := str_dir
    if stats_on
        if disp_up_bar and (not disp_ref or (not na(cs.ref_hi) and close > cs.ref_hi))
            cs.disp_up := true
        if disp_dn_bar and (not disp_ref or (not na(cs.ref_lo) and close < cs.ref_lo))
            cs.disp_dn := true
        if div_bull_evt
            cs.div_bull := true
        if div_bear_evt
            cs.div_bear := true
        f_ref_step(cs)
    true

f_step(Track t, bool active, bool st, bool en, bool box_on, bool mid_on, bool hl_on, bool stats_on, float m_hi, float m_lo) =>
    // ── START: first bar inside the session
    if st
        Sess ns = Sess.new(nm = t.nm, pfx = t.pfx, col = t.col)
        ns.t0      := time
        ns.t1      := time
        ns.px_o    := open
        ns.px_c    := close
        ns.hi      := high
        ns.lo      := low
        ns.adr     := adr
        ns.partial := bar_index == 0
        ns.rh      := Side.new()
        ns.rl      := Side.new()
        ns.oh      := Side.new()
        ns.ol      := Side.new()
        if stats_on
            // benchmark = PRIOR completed sessions only; reference = frozen levels of OTHER sessions
            ns.avg    := array.size(t.rngs) >= hist_need ? f_bench(t.rngs) : na
            ns.exp_n  := array.size(t.nbs) >= 3 ? array.median(t.nbs) : na
            ns.ref_hi := f_ref(m_hi, t.last_hi, true)
            ns.ref_lo := f_ref(m_lo, t.last_lo, false)
        ns.live := true
        array.push(t.sess, ns)
        if array.size(t.sess) > hist_eff
            Sess old = array.shift(t.sess)
            if draw_step
                f_del(old)
        if draw_step and ext_mode == "Until next session" and array.size(t.sess) > 1
            f_cut(array.get(t.sess, array.size(t.sess) - 2), time)

    // ── ACTIVE: update the developing session (the first bar after the session never gets here)
    if active and array.size(t.sess) > 0
        Sess cs = array.last(t.sess)
        if cs.live
            f_bar(cs, stats_on)
            if draw_ok and draw_step
                if not cs.drawn
                    f_create(cs, box_on, mid_on, hl_on)
                    cs.drawn := true
                f_update(cs, time)
            if stats_on and barstate.islast
                f_live_eval(cs)

    // ── END: active → inactive. Freeze first, classify from the frozen state afterwards.
    if en and array.size(t.sess) > 0
        Sess fs = array.last(t.sess)
        if fs.live
            fs.live := false
            fs.t1   := t_prev
            f_calc(fs)
            if stats_on
                float q = na
                if array.size(t.nbs) >= 3
                    float med = array.median(t.nbs)
                    if med > 0
                        q := fs.nbars / med
                fs.valid := not (ign_part and fs.partial) and fs.nbars >= min_bars and (na(q) or q >= min_q / 100.0)
                string old_ph = fs.ph_live
                if fs.valid
                    [ph, pc, bd, why] = f_classify(fs)
                    [lq, lc] = f_liq(fs)
                    fs.phase     := ph
                    fs.phase_col := pc
                    fs.dir       := bd
                    fs.liq       := lq
                    fs.liq_col   := lc
                    fs.why       := why
                    array.push(t.rngs, fs.rng)
                    if array.size(t.rngs) > range_len
                        array.shift(t.rngs)
                    array.push(t.nbs, float(fs.nbars))
                    if array.size(t.nbs) > range_len
                        array.shift(t.nbs)
                else
                    fs.phase     := "N/A"
                    fs.phase_col := col_neutral
                    fs.dir       := 0
                    fs.liq       := "—"
                    fs.liq_col   := col_neutral
                fs.ph_live := fs.phase
                f_phase_ev(fs, old_ph, fs.phase)
            if not fs.partial
                t.last_hi := fs.hi
                t.last_lo := fs.lo
            if fs.drawn and draw_step
                f_update(fs, t_prev)
                if ext_mode != "None"
                    Side foh = fs.oh
                    Side fol = fs.ol
                    if not na(fs.ln_h)
                        line.set_extend(fs.ln_h, extend.right)
                        foh.life := 1
                    if not na(fs.ln_l)
                        line.set_extend(fs.ln_l, extend.right)
                        fol.life := 1
                if stats_on and show_bias_lbl and fs.valid and fs.phase != "WARM-UP"
                    fs.lb_bias := label.new(int((fs.t0 + t_prev) / 2), fs.lo, fs.phase, xloc = xloc.bar_time, style = label.style_label_up, color = color.new(fs.phase_col, 85), textcolor = fs.phase_col, size = bias_size)
    true

// carried-forward H/L of finished sessions: stop the line when the sweep definition is met
f_sweeps(Track t) =>
    int n = array.size(t.sess)
    if draw_step and draw_ok and ext_mode == "Until swept" and n > 0
        for i = 0 to n - 1
            Sess s = array.get(t.sess, i)
            if s.drawn and not s.live and time > s.t1
                Side oh = s.oh
                Side ol = s.ol
                if oh.life == 1 and not na(s.ln_h)
                    if f_sweep_hit(oh, s.hi, true)
                        oh.life  := 2
                        oh.swept := true
                        line.set_extend(s.ln_h, extend.none)
                        line.set_x2(s.ln_h, time)
                        if show_sweep_mk
                            s.mk_h := label.new(time, s.hi, "×", xloc = xloc.bar_time, style = label.style_none, textcolor = s.col, size = tag_size)
                if ol.life == 1 and not na(s.ln_l)
                    if f_sweep_hit(ol, s.lo, false)
                        ol.life  := 2
                        ol.swept := true
                        line.set_extend(s.ln_l, extend.none)
                        line.set_x2(s.ln_l, time)
                        if show_sweep_mk
                            s.mk_l := label.new(time, s.lo, "×", xloc = xloc.bar_time, style = label.style_none, textcolor = s.col, size = tag_size)
    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 12 · MACRO LEVEL DRAWING
//   Right strip : bar-index lines that start after a gap from the live candle and run to the price axis (or for a set length), label at a fixed offset, line start or line end.
//   Full line   : original look, time-based line from the start of the period, right-edge label.
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_lvl(Lvl l, float px, int t0, color c, string txt, string sty) =>
    if not na(px) and not na(t0)
        string tx = txt + "  " + str.tostring(px, format.mintick)
        if lvl_strip
            int x1 = bar_index + lvl_gap
            int x2 = x1 + (lvl_ext ? 1 : lvl_len)
            if na(l.ln)
                l.ln := line.new(x1, px, x2, px, xloc = xloc.bar_index, extend = lvl_ext ? extend.right : extend.none, color = c, style = sty, width = lvl_w)
            line.set_xy1(l.ln, x1, px)
            line.set_xy2(l.ln, x2, px)
            if show_mlbl
                bool at_end = lvl_lbl_pos == "Line end" and not lvl_ext
                int  lx     = lvl_lbl_pos == "Fixed offset" ? bar_index + math.max(lvl_lbl_gap, lvl_gap) : at_end ? x2 : x1
                if na(l.lb)
                    l.lb := label.new(lx, px, tx, xloc = xloc.bar_index, style = at_end ? label.style_label_left : label.style_label_lower_left, color = color.new(c, 100), textcolor = c, size = px_size)
                label.set_xy(l.lb, lx, px)
                label.set_text(l.lb, tx)
        else
            int x2t = math.max(time, t0) + tf_ms
            if na(l.ln)
                l.ln := line.new(t0, px, x2t, px, xloc = xloc.bar_time, extend = extend.right, color = c, style = sty, width = lvl_w)
            line.set_xy1(l.ln, t0, px)
            line.set_xy2(l.ln, x2t, px)
            if show_mlbl
                if na(l.lb)
                    l.lb := label.new(bar_index + lbl_off, px, tx, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = px_size)
                label.set_xy(l.lb, bar_index + lbl_off, px)
                label.set_text(l.lb, tx)
    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 13 · DASHBOARD
//   logical columns: 0 SESSION · 1 PHASE · 2 LIQUIDITY · 3 RANGE · 4 % ADR · 5 BAR VOL · 6 FLOW · 7 STRUCTURE · 8 BIAS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var array<string> dash_hdr = array.from("SESSION", "PHASE", "LIQUIDITY", "RANGE", "% ADR", "BAR VOL", "FLOW", "STRUCTURE", "BIAS")

f_colmap() =>
    array<int> a = array.new<int>()
    if dash_detail == "Compact"
        a := array.from(0, 1, 2, 8)
    else if dash_detail == "Standard"
        a := array.from(0, 1, 2, 3, 4, 8)
    else
        a := array.from(0, 1, 2, 3, 4, 5, 6, 7, 8)
    a

var array<int> colmap = f_colmap()

int    dash_cols = dash_detail == "Compact" ? 4 : dash_detail == "Standard" ? 6 : 9
bool   need_note = hist_clamped or tf_coarse
int    dash_rows = need_note ? 6 : 5
string note_txt  = (hist_clamped ? "⚠ history capped at " + str.tostring(hist_eff) + " sessions (label limit)" : "") + (hist_clamped and tf_coarse ? "  ·  " : "") + (tf_coarse ? "⚠ coarse timeframe: few bars per session" : "")

var table dash = show_dash ? table.new(dash_pos, tf_ok ? dash_cols : 1, tf_ok ? dash_rows : 1, frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 80), border_width = 1) : na

f_dash_row(table tb, int r, Track t, array<int> cm) =>
    array<string> tx = array.new<string>(9, "—")
    array<color>  tc = array.new<color>(9, dash_txt)
    bool lv = false
    if array.size(t.sess) > 0
        Sess s = array.last(t.sess)
        lv := s.live
        array.set(tx, 1, s.phase)
        array.set(tc, 1, na(s.phase_col) ? dash_txt : s.phase_col)
        array.set(tx, 2, s.liq)
        array.set(tc, 2, na(s.liq_col) ? dash_txt : s.liq_col)
        if not na(s.rng)
            [cx, cc] = f_rng_class(s.rt)
            array.set(tx, 3, f_rng(s.rng) + (na(s.rt) ? "" : "  " + str.tostring(s.rt, "0.00") + "× " + cx))
            array.set(tc, 3, cc)
        if not na(s.adr_u)
            array.set(tx, 4, str.tostring(s.adr_u * 100, "#") + "%")
            array.set(tc, 4, s.adr_u < 0.5 ? col_bull : s.adr_u < 0.9 ? col_warn : col_bear)
        if not atr_on
            array.set(tx, 5, "OFF")
        else if not na(s.atr_rt)
            [vt, vc] = f_vol_cls(s.atr_rt)
            array.set(tx, 5, str.tostring(s.atr_rt, "0.00") + "× " + vt)
            array.set(tc, 5, vc)
        if not na(s.flow)
            array.set(tx, 6, (s.flow >= 0 ? "+" : "") + str.tostring(s.flow, "0.00") + (s.flow > thr_flow ? " ▲" : s.flow < -thr_flow ? " ▼" : " ◆"))
            array.set(tc, 6, s.flow > thr_flow ? col_bull : s.flow < -thr_flow ? col_bear : col_neutral)
        if not str_on
            array.set(tx, 7, "OFF")
        else
            array.set(tx, 7, s.str_dir > 0 ? "▲ UP" : s.str_dir < 0 ? "▼ DOWN" : "◆ RANGE")
            array.set(tc, 7, s.str_dir > 0 ? col_bull : s.str_dir < 0 ? col_bear : col_neutral)
        int bd = s.valid ? s.dir : 0
        array.set(tx, 8, bd > 0 ? "▲ BULL" : bd < 0 ? "▼ BEAR" : "◆ NEUTRAL")
        array.set(tc, 8, bd > 0 ? col_bull : bd < 0 ? col_bear : col_neutral)
    array.set(tx, 0, (lv ? "● " : "○ ") + t.nm)
    array.set(tc, 0, t.col)
    for c = 0 to array.size(cm) - 1
        int id = array.get(cm, c)
        table.cell(tb, c, r, array.get(tx, id), text_color = array.get(tc, id), bgcolor = dash_row_bg, text_size = dash_tsz, text_halign = id == 0 ? text.align_left : text.align_center)
    true

f_dash_day(table tb, int r, array<int> cm) =>
    array<string> tx = array.new<string>(9, "—")
    array<color>  tc = array.new<color>(9, dash_txt)
    array.set(tx, 0, "DAY")
    if not na(d_open)
        bool above = close >= d_open
        array.set(tx, 1, above ? "▲ ABOVE DO" : "▼ BELOW DO")
        array.set(tc, 1, above ? col_bull : col_bear)
    if not na(pdh) and not na(pdl)
        array.set(tx, 2, close > pdh ? "ABOVE PDH" : close < pdl ? "BELOW PDL" : "INSIDE PD")
        array.set(tc, 2, close > pdh ? col_bull : close < pdl ? col_bear : col_neutral)
    if not na(adr)
        array.set(tx, 3, "ADR " + f_rng(adr))
        if adr > 0 and not na(dev_hi) and not na(dev_lo)
            float u = (dev_hi - dev_lo) / adr
            array.set(tx, 4, str.tostring(u * 100, "#") + "% used")
            array.set(tc, 4, u < 0.5 ? col_bull : u < 0.9 ? col_warn : col_bear)
    if not atr_on
        array.set(tx, 5, "OFF")
    else if not na(bar_rt)
        [vt, vc] = f_vol_cls(bar_rt)
        array.set(tx, 5, "bar " + str.tostring(bar_rt, "0.00") + "× " + vt)
        array.set(tc, 5, vc)
    array.set(tx, 6, flow_lbl)
    if not str_on
        array.set(tx, 7, "OFF")
    else
        array.set(tx, 7, str_dir > 0 ? "▲ UP" : str_dir < 0 ? "▼ DOWN" : "◆ RANGE")
        array.set(tc, 7, str_dir > 0 ? col_bull : str_dir < 0 ? col_bear : col_neutral)
    string act_txt = (act_asia ? "AS " : "") + (act_eur ? pf_eur + " " : "") + (act_usa ? pf_usa : "")
    array.set(tx, 8, act_txt == "" ? "—" : act_txt)
    for c = 0 to array.size(cm) - 1
        int id = array.get(cm, c)
        table.cell(tb, c, r, array.get(tx, id), text_color = id == 0 ? dash_txt : array.get(tc, id), bgcolor = id == 0 ? dash_hdr_bg : dash_row_bg, text_size = dash_tsz, text_halign = id == 0 ? text.align_left : text.align_center)
    true

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VARIABLES FOR SESSION RANGES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float a_hi = na, var float a_lo = na, var float a_avg = na, var int a_start = na
var float e_hi = na, var float e_lo = na, var float e_avg = na, var int e_start = na
var float u_hi = na, var float u_lo = na, var float u_avg = na, var int u_start = na

// Asian Macro Data & Backtest Tag
if time_asian_macro and not time_asian_macro[1]
    a_hi := high, a_lo := low, a_start := time
if time_asian_macro
    a_hi := math.max(a_hi, high), a_lo := math.min(a_lo, low)
if not time_asian_macro and time_asian_macro[1]
    pts = (a_hi - a_lo) / syminfo.mintick
    
    // ✅ FIX: Update average FIRST
    a_avg := na(a_avg) ? pts : (a_avg * (range_avg_len - 1) + pts) / range_avg_len
    
    // THEN calculate bias
    [ph, pcol, liq, lcol, v, vcol, r_st, rcol] = get_ultra_bias(pts, a_avg, a_hi, a_lo, a_start, 25200000)
    
    // ✅ FIX: avoid early wrong labels
    if show_history and not na(a_avg)
        mid_time = int((a_start + time[1]) / 2)
        label.new(mid_time, a_lo, ph, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(pcol, 85), textcolor=pcol, size=size.tiny)
    
    // SAVE ALL FINAL STATES
    a_last_phase := ph, a_last_pcol := pcol
    a_last_liq   := liq, a_last_lcol := lcol
    a_last_vol   := v,   a_last_vcol := vcol
    a_last_rng   := r_st, a_last_rcol := rcol

// Europe Data & Backtest Tag
if time_europe and not time_europe[1]
    e_hi := high, e_lo := low, e_start := time
if time_europe
    e_hi := math.max(e_hi, high), e_lo := math.min(e_lo, low)
if not time_europe and time_europe[1]
    pts = (e_hi - e_lo) / syminfo.mintick
    
    // ✅ FIX: Update average FIRST
    e_avg := na(e_avg) ? pts : (e_avg * (range_avg_len - 1) + pts) / range_avg_len
    
    // THEN calculate bias
    [ph, pcol, liq, lcol, v, vcol, r_st, rcol] = get_ultra_bias(pts, e_avg, e_hi, e_lo, e_start, 30600000)
    
    // ✅ FIX: avoid early wrong labels
    if show_history and not na(e_avg)
        mid_time = int((e_start + time[1]) / 2)
        label.new(mid_time, e_lo, ph, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(pcol, 85), textcolor=pcol, size=size.tiny)
    
    // SAVE ALL FINAL STATES
    e_last_phase := ph, e_last_pcol := pcol
    e_last_liq   := liq, e_last_lcol := lcol
    e_last_vol   := v,   e_last_vcol := vcol
    e_last_rng   := r_st, e_last_rcol := rcol

// USA Data & Backtest Tag
if time_usa and not time_usa[1]
    u_hi := high, u_lo := low, u_start := time
if time_usa
    u_hi := math.max(u_hi, high), u_lo := math.min(u_lo, low)
if not time_usa and time_usa[1]
    pts = (u_hi - u_lo) / syminfo.mintick
    
    // ✅ FIX: Update average FIRST
    u_avg := na(u_avg) ? pts : (u_avg * (range_avg_len - 1) + pts) / range_avg_len
    
    // THEN calculate bias
    [ph, pcol, liq, lcol, v, vcol, r_st, rcol] = get_ultra_bias(pts, u_avg, u_hi, u_lo, u_start, 23400000)
    
    // ✅ FIX: avoid early wrong labels
    if show_history and not na(u_avg)
        mid_time = int((u_start + time[1]) / 2)
        label.new(mid_time, u_lo, ph, xloc=xloc.bar_time, style=label.style_label_up, color=color.new(pcol, 85), textcolor=pcol, size=size.tiny)
    
    // SAVE ALL FINAL STATES
    u_last_phase := ph, u_last_pcol := pcol
    u_last_liq   := liq, u_last_lcol := lcol
    u_last_vol   := v,   u_last_vcol := vcol
    u_last_rng   := r_st, u_last_rcol := rcol

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// MULTI-COLUMN DASHBOARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table dash = table.new(position.top_right, 5, 4, border_color = color.new(color.gray, 80), border_width = 1)

if show_dashboard and barstate.islast
    // Background Colors
    color hdr_bg = color.new(color.black, 0)      // Solid black for headers
    color dat_bg = color.new(#1e222d, 0)          // Uniform dark slate for all internal data

    // Headers
    table.cell(dash, 0, 0, "Session",      text_color=color.white, bgcolor=hdr_bg, text_size=size.small)
    table.cell(dash, 1, 0, "MARKET PHASE", text_color=color.white, bgcolor=hdr_bg, text_size=size.small)
    table.cell(dash, 2, 0, "LIQUIDITY",    text_color=color.white, bgcolor=hdr_bg, text_size=size.small)
    table.cell(dash, 3, 0, "VOLATILITY",   text_color=color.white, bgcolor=hdr_bg, text_size=size.small)
    table.cell(dash, 4, 0, "RANGE",        text_color=color.white, bgcolor=hdr_bg, text_size=size.small)

    // Asian Logic
    a_curr = na(a_hi) or na(a_lo) ? 0 : math.round((a_hi - a_lo) / syminfo.mintick)
    [a_l_ph, a_l_pcol, a_l_liq, a_l_lcol, a_l_vol, a_l_vcol, a_l_rng, a_l_rcol] = get_ultra_bias(a_curr, a_avg, a_hi, a_lo, a_start, 25200000)
    
    table.cell(dash, 0, 1, "Asian", text_color=c_asia, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 1, 1, time_asian_macro ? a_l_ph : a_last_phase, text_color=time_asian_macro ? a_l_pcol : a_last_pcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 2, 1, time_asian_macro ? a_l_liq : a_last_liq, text_color=time_asian_macro ? a_l_lcol : a_last_lcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 3, 1, time_asian_macro ? a_l_vol : a_last_vol, text_color=time_asian_macro ? a_l_vcol : a_last_vcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 4, 1, time_asian_macro ? a_l_rng : a_last_rng, text_color=time_asian_macro ? a_l_rcol : a_last_rcol, bgcolor=dat_bg, text_size=size.small)

    // Europe Logic
    e_curr = na(e_hi) or na(e_lo) ? 0 : math.round((e_hi - e_lo) / syminfo.mintick)
    [e_l_ph, e_l_pcol, e_l_liq, e_l_lcol, e_l_vol, e_l_vcol, e_l_rng, e_l_rcol] = get_ultra_bias(e_curr, e_avg, e_hi, e_lo, e_start, 30600000)
    
    table.cell(dash, 0, 2, "Europe", text_color=c_europe, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 1, 2, time_europe ? e_l_ph : e_last_phase, text_color=time_europe ? e_l_pcol : e_last_pcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 2, 2, time_europe ? e_l_liq : e_last_liq, text_color=time_europe ? e_l_lcol : e_last_lcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 3, 2, time_europe ? e_l_vol : e_last_vol, text_color=time_europe ? e_l_vcol : e_last_vcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 4, 2, time_europe ? e_l_rng : e_last_rng, text_color=time_europe ? e_l_rcol : e_last_rcol, bgcolor=dat_bg, text_size=size.small)

    // USA Logic
    u_curr = na(u_hi) or na(u_lo) ? 0 : math.round((u_hi - u_lo) / syminfo.mintick)
    [u_l_ph, u_l_pcol, u_l_liq, u_l_lcol, u_l_vol, u_l_vcol, u_l_rng, u_l_rcol] = get_ultra_bias(u_curr, u_avg, u_hi, u_lo, u_start, 23400000)
    
    table.cell(dash, 0, 3, "USA", text_color=c_usa, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 1, 3, time_usa ? u_l_ph : u_last_phase, text_color=time_usa ? u_l_pcol : u_last_pcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 2, 3, time_usa ? u_l_liq : u_last_liq, text_color=time_usa ? u_l_lcol : u_last_lcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 3, 3, time_usa ? u_l_vol : u_last_vol, text_color=time_usa ? u_l_vcol : u_last_vcol, bgcolor=dat_bg, text_size=size.small)
    table.cell(dash, 4, 3, time_usa ? u_l_rng : u_last_rng, text_color=time_usa ? u_l_rcol : u_last_rcol, bgcolor=dat_bg, text_size=size.small)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENGINE 4: MACRO LIQUIDITY (PDH/PDL, PWH/PWL)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var line pdh_line = na
var line pdl_line = na
var label pdh_lbl = na
var label pdl_lbl = na

var line pwh_line = na
var line pwl_line = na
var label pwh_lbl = na
var label pwl_lbl = na

var int line_start_gap = 20
var int text_pos_gap = 40

if barstate.islast
    // Daily
    if show_pdhl
        pdh_text = "PDH : " + str.tostring(pdh, format.mintick)
        pdl_text = "PDL : " + str.tostring(pdl, format.mintick)
        if na(pdh_line)
            pdh_line := line.new(bar_index + line_start_gap, pdh, bar_index + line_start_gap + 1, pdh, color=color.gray, style=line.style_dashed, width=1, extend=extend.right)
            pdl_line := line.new(bar_index + line_start_gap, pdl, bar_index + line_start_gap + 1, pdl, color=color.gray, style=line.style_dashed, width=1, extend=extend.right)
            pdh_lbl  := label.new(bar_index + text_pos_gap, pdh, pdh_text, style=label.style_none, textcolor=color.gray, size=size.small)
            pdl_lbl  := label.new(bar_index + text_pos_gap, pdl, pdl_text, style=label.style_none, textcolor=color.gray, size=size.small)
        else
            line.set_xy1(pdh_line, bar_index + line_start_gap, pdh)
            line.set_xy2(pdh_line, bar_index + line_start_gap + 1, pdh)
            line.set_xy1(pdl_line, bar_index + line_start_gap, pdl)
            line.set_xy2(pdl_line, bar_index + line_start_gap + 1, pdl)
            label.set_xy(pdh_lbl, bar_index + text_pos_gap, pdh)
            label.set_text(pdh_lbl, pdh_text)
            label.set_xy(pdl_lbl, bar_index + text_pos_gap, pdl)
            label.set_text(pdl_lbl, pdl_text)

    // Weekly
    if show_pwhl
        pwh_text = "PWH : " + str.tostring(pwh, format.mintick)
        pwl_text = "PWL : " + str.tostring(pwl, format.mintick)
        if na(pwh_line)
            pwh_line := line.new(bar_index + line_start_gap, pwh, bar_index + line_start_gap + 1, pwh, color=color.new(color.white, 40), style=line.style_dotted, width=2, extend=extend.right)
            pwl_line := line.new(bar_index + line_start_gap, pwl, bar_index + line_start_gap + 1, pwl, color=color.new(color.white, 40), style=line.style_dotted, width=2, extend=extend.right)
            pwh_lbl  := label.new(bar_index + text_pos_gap, pwh, pwh_text, style=label.style_none, textcolor=color.new(color.white, 40), size=size.small)
            pwl_lbl  := label.new(bar_index + text_pos_gap, pwl, pwl_text, style=label.style_none, textcolor=color.new(color.white, 40), size=size.small)
        else
            line.set_xy1(pwh_line, bar_index + line_start_gap, pwh)
            line.set_xy2(pwh_line, bar_index + line_start_gap + 1, pwh)
            line.set_xy1(pwl_line, bar_index + line_start_gap, pwl)
            line.set_xy2(pwl_line, bar_index + line_start_gap + 1, pwl)
            label.set_xy(pwh_lbl, bar_index + text_pos_gap, pwh)
            label.set_text(pwh_lbl, pwh_text)
            label.set_xy(pwl_lbl, bar_index + text_pos_gap, pwl)
            label.set_text(pwl_lbl, pwl_text)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// EXECUTE DRAWINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
time_merged_asian_box = (show_sydney_box and time_sydney) or (show_tokyo_box and time_asia) or (show_china_box and time_china)
draw_box(merge_asian_box and time_merged_asian_box, c_asia, "Asian")

draw_box(not merge_asian_box and show_sydney_box and time_sydney, c_sydney, "Sydney")
draw_box(not merge_asian_box and show_tokyo_box  and time_asia,   c_asia,   "Tokyo")
draw_box(not merge_asian_box and show_china_box  and time_china,  c_china,  "Shanghai")

draw_box(show_london_box and time_europe, c_europe, "London")
draw_box(show_usa_box    and time_usa,    c_usa,    "New York")

draw_liquidity_lines(time_asian_macro, c_asia,   "A", show_asian_lines,  show_asian_hl)
draw_liquidity_lines(time_europe,      c_europe, "E", show_london_lines, show_europe_hl)
draw_liquidity_lines(time_usa,         c_usa,    "U", show_usa_lines,    show_usa_hl)
